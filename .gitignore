# Compiled binary (do not ignore src/glimpse.swift or src/glimpse.mjs)
src/glimpse
src/glimpse.exe
src/Glimpse.app/

# Iconset intermediates (keep AppIcon.icns / AppIcon-1024.png)
assets/AppIcon.iconset/

# Linux build output
src/linux/target/

# Windows Rust build output
src/windows/target/
src/windows/Cargo.lock

# Legacy .NET build output (kept for reference during transition)
native/windows/bin/
native/windows/obj/

# Build markers
.glimpse-build-skipped

# Dependencies
node_modules/
raycast-extension/node_modules/
raycast-extension/dist/
# Compiled Raycast command executables (generated by npm run build)
raycast-extension/*.js
raycast-extension/*.js.map

